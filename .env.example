# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.

# --- 관리자 로그인 ---
ADMIN_ID=
ADMIN_PASSWORD=
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- 블로그 (티스토리) ---
BLOG_URL=https://rinhye05.tistory.com
# 티스토리를 다시 읽어오는 주기(초). 0이면 매 요청마다 새로 가져옵니다.
BLOG_REVALIDATE=60

# --- 프로젝트 편집 → GitHub 커밋 ---
# github.com/settings/personal-access-tokens 에서 이 레포에만 Contents: Read and write 권한을 준 토큰
GITHUB_TOKEN=
GITHUB_REPO=rinhye05/cedrai-portfolio
GITHUB_BRANCH=main
GITHUB_FILE_PATH=data/projects.json
